# ===== 环境变量模板 =====
# 复制此文件为 .env 并填入真实值

# 高德地图 Key
# 申请地址: https://console.amap.com/dev/key/app
PUBLIC_AMAP_KEY=
PUBLIC_AMAP_KEY_PLACES=

# Umami 统计
# 上报与读数是两套接口，Cloud 上前缀不同（详见 src/config/siteConfig.ts 注释）：
#   上报脚本 https://cloud.umami.is/script.js  →  POST /api/send
#   读取数据 https://cloud.umami.is/analytics/us/api/websites/{id}/stats
# 用 Umami Cloud 时 PUBLIC_UMAMI_BASE 留空即可；用自托管时填服务地址（不带末尾斜杠）。
PUBLIC_UMAMI_BASE=
# 只有自托管且站点挂在子路径下（如 Cloud 的 /analytics/us）才需要单独填；留空自动推导
PUBLIC_UMAMI_API_BASE=
PUBLIC_UMAMI_USERNAME=
PUBLIC_UMAMI_PASSWORD=
PUBLIC_UMAMI_WEBSITE_ID=
# 公开分享码（https://cloud.umami.is/share/{这一串}），首页「访问轨迹」实时取数用；不是密钥
PUBLIC_UMAMI_SHARE_ID=

# Waline 评论与留言（部署见 docs/deploy-github-pages.md 第四节）
# 示例：https://your-waline-project.vercel.app
PUBLIC_WALINE_SERVER=

# 可选：CloudFlare ImgBed 回退（本地相册不需要；部署见 docs/deploy-cloudflare-imgbed.md）
# 部署地址，不带末尾斜杠
PUBLIC_IMAGEBED_URL=
# 浏览器可见的只读 API Token：只能授予 list 权限，禁止 upload/delete/manage
PUBLIC_IMAGEBED_API_TOKEN=

# 文章朗读 TTS 服务地址（EdgeOne Pages 环境变量 + 本地 .env；留空则用系统语音）
PUBLIC_TTS_SERVER=

# 阿里云 DashScope（千问）API Key——scripts/生成摘要 脚本用，绝不写入被跟踪的文件
DASHSCOPE_API_KEY=
