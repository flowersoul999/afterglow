---
// 完整样式与脚本都走本地依赖（@waline/client 已在 package.json 中）。
// 早前从 unpkg.com 拉取，国内直连返回 000，评论区和留言板会整体失效。
import "@waline/client/style";
import "@/styles/vendor/waline.css";
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.waline,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",
	wordLimit: ["2", "300"],
	requiredMeta: ["nick", "mail"],
	...(commentConfig.waline?.visitorCount ? { pageview: true } : {}),
};
---
<!-- Waline -->
<div class="relative w-full">
  <div id="waline" data-waline-config={JSON.stringify(config)}></div>
  <script>
    import { init } from "@waline/client/full";

    const container = document.getElementById("waline");
    const rawConfig = container?.dataset.walineConfig;
    if (container && rawConfig) {
      init(JSON.parse(rawConfig));
    }
  </script>
</div>