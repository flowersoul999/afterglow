---
import { Icon } from "astro-icon/components";

interface Props {
	class?: string;
	style?: string;
}
const { class: className, style } = Astro.props;
---

<div class:list={["douyin-hot-widget", className]} style={style}>
  <div class="douyin-hot-header">
    <div class="douyin-hot-title">
      <svg class="douyin-hot-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.48 6.3 6.3 0 001.86-4.49V8.87a8.27 8.27 0 004.72 1.49V6.89a4.84 4.84 0 01-1-.2z"/>
      </svg>
      <span>抖音热搜</span>
    </div>
    <button class="douyin-hot-refresh" id="douyin-hot-refresh" title="刷新" aria-label="刷新" type="button">
      <Icon name="material-symbols:refresh" class="text-sm" />
    </button>
  </div>
  <div class="douyin-hot-list" id="douyin-hot-list">
    <div class="douyin-hot-loading">
      <div class="douyin-hot-skeleton"></div>
      <div class="douyin-hot-skeleton"></div>
      <div class="douyin-hot-skeleton"></div>
      <div class="douyin-hot-skeleton"></div>
      <div class="douyin-hot-skeleton"></div>
    </div>
  </div>
  <div class="douyin-hot-error" id="douyin-hot-error" style="display:none">
    <span class="text-xs text-(--content-meta)">加载失败，点击刷新重试</span>
  </div>
</div>

<script is:inline>
(function() {
  var API_URL = "https://v2.xxapi.cn/api/douyinhot";
  var CACHE_KEY = "__douyinHotCache";
  var CACHE_TTL = 5 * 60 * 1000; // 5分钟缓存

  function formatHotValue(val) {
    if (val >= 10000) return (val / 10000).toFixed(1) + "万";
    return String(val);
  }

  function renderList(data) {
    var list = document.getElementById("douyin-hot-list");
    if (!list || !data || !data.length) return;

    var html = "";
    for (var i = 0; i < Math.min(data.length, 5); i++) {
      var item = data[i];
      var pos = item.position || (i + 1);
      var word = item.word || "";
      var hotVal = item.hot_value ? formatHotValue(item.hot_value) : "";
      var coverUrl = "";
      if (item.word_cover && item.word_cover.url_list && item.word_cover.url_list.length > 0) {
        coverUrl = item.word_cover.url_list[0];
      }

      var rankClass = pos <= 3 ? " douyin-hot-rank--top" : "";
      var searchUrl = "https://www.douyin.com/search/" + encodeURIComponent(word);

      html += '<a class="douyin-hot-item' + rankClass + '" href="' + escHtml(searchUrl) + '" target="_blank" rel="noopener noreferrer">';
      html += '  <span class="douyin-hot-rank">' + pos + '</span>';
      html += '  <div class="douyin-hot-item-body">';
      html += '    <span class="douyin-hot-word">' + escHtml(word) + '</span>';
      if (hotVal) {
        html += '    <span class="douyin-hot-value">' + hotVal + '</span>';
      }
      html += '  </div>';
      if (coverUrl) {
        html += '  <img class="douyin-hot-thumb" src="' + escHtml(coverUrl) + '" alt="" loading="lazy" />';
      }
      html += '</a>';
    }
    list.innerHTML = html;
  }

  function escHtml(t) {
    var d = document.createElement("div");
    d.textContent = t;
    return d.innerHTML;
  }

  function showError() {
    var err = document.getElementById("douyin-hot-error");
    var list = document.getElementById("douyin-hot-list");
    if (err) err.style.display = "";
    if (list) list.style.display = "none";
  }

  function hideError() {
    var err = document.getElementById("douyin-hot-error");
    var list = document.getElementById("douyin-hot-list");
    if (err) err.style.display = "none";
    if (list) list.style.display = "";
  }

  function fetchHot() {
    hideError();

    // 检查缓存
    try {
      var cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        var parsed = JSON.parse(cached);
        if (parsed.time > Date.now() - CACHE_TTL && parsed.data) {
          renderList(parsed.data);
          return;
        }
      }
    } catch(e) {}

    fetch(API_URL)
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.code === 200 && Array.isArray(res.data)) {
          renderList(res.data);
          // 缓存
          try {
            sessionStorage.setItem(CACHE_KEY, JSON.stringify({
              data: res.data,
              time: Date.now()
            }));
          } catch(e) {}
        } else {
          showError();
        }
      })
      .catch(function() {
        showError();
      });
  }

  // 刷新按钮
  var refreshBtn = document.getElementById("douyin-hot-refresh");
  if (refreshBtn) {
    refreshBtn.addEventListener("click", function() {
      try { sessionStorage.removeItem(CACHE_KEY); } catch(e) {}
      fetchHot();
    });
  }

  // 错误区域点击重试
  var errEl = document.getElementById("douyin-hot-error");
  if (errEl) {
    errEl.style.cursor = "pointer";
    errEl.addEventListener("click", function() {
      try { sessionStorage.removeItem(CACHE_KEY); } catch(e) {}
      fetchHot();
    });
  }

  fetchHot();
})();
</script>
