---
import { Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import DropdownItem from "@/components/common/DropdownItem.astro";
import { announcementConfig, navBarConfig, siteConfig } from "@/config";
import { DARK_MODE, LIGHT_MODE, SYSTEM_MODE } from "@/constants/constants";
import { LinkPresets } from "@/constants/link-presets";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { LinkPreset, type NavBarLink } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { resolveNavLinks } from "@/utils/nav-categories";
import { url } from "@/utils/url-utils";
import DropdownMenu from "./DropdownMenu.astro";
import NavbarProfileCard from "./NavbarProfileCard.astro";

const navbarTitle = siteConfig.navbar.title || siteConfig.title;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

// 「分类」等动态菜单的子项在这里注入（配置里只有按钮），
// 数据来自文章目录，新加分类文件夹后无需改配置
const links: NavBarLink[] = await resolveNavLinks(navBarConfig.links);

/**
 * 共享下拉面板的内容页：带子菜单的导航项各占一页，
 * 页序号与触发器容器上的 data-dropdown-index 配对。
 * 整条导航只有一只面板，内容页全渲染在这里、靠切换 is-active 交叉淡换。
 */
interface NavbarDropdownPage {
	index: number;
	/** 「分类」那种多列排布，沿用站内 .dropdown-grid，只改排列不改外观 */
	grid: boolean;
	children: NavBarLink[];
}

const resolveChild = (child: NavBarLink | LinkPreset): NavBarLink | null =>
	typeof child === "number" ? (LinkPresets[child] ?? null) : child;

const dropdownPages: NavbarDropdownPage[] = links
	.map((link, index) => ({
		index,
		grid: link.dynamicSource === "post-categories",
		children: (link.children ?? [])
			.map(resolveChild)
			.filter((child): child is NavBarLink => child !== null),
	}))
	.filter((page) => page.children.length > 0);

// 工具面板主题行的三段滑块，值对应 setting-utils 的 LIGHT_DARK_MODE
const toolsThemeOptions = [
	{
		value: LIGHT_MODE,
		label: i18n(I18nKey.themeLight),
		icon: "material-symbols:light-mode-outline-rounded",
	},
	{
		value: DARK_MODE,
		label: i18n(I18nKey.themeDark),
		icon: "material-symbols:dark-mode-outline-rounded",
	},
	{
		value: SYSTEM_MODE,
		label: i18n(I18nKey.themeSystem),
		icon: "material-symbols:brightness-auto-outline-rounded",
	},
];

const showAnnouncement = Boolean(announcementConfig.content);

// Logo
const logoValue = siteConfig.navbar.logo?.value || "";
const isLocalSrcLogo =
	siteConfig.navbar.logo?.type === "image" &&
	logoValue &&
	!logoValue.startsWith("/") &&
	!logoValue.startsWith("http");
let logoImg: ImageMetadata | null = null;

if (isLocalSrcLogo) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
		{ import: "default" },
	);
	const normalizedPath = path
		.normalize(path.join("../../", logoValue))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (file) logoImg = await file();
}
---

<div id="navbar" class="z-50" data-full-width={String(navbarWidthFull)} style="margin-top: 10px;">
	<NavbarProfileCard />

	<div class="navbar-segments">
		<!-- 左段：logo + 标题（滚动收缩成球） -->
		<div class="navbar-seg navbar-seg--left">
			<a href={url("/")} class="navbar-logo scale-animation flex items-center text-(--deep-text)">
				{siteConfig.navbar.logo?.type === "icon" ? (
					<Icon name={siteConfig.navbar.logo.value || "material-symbols:home-pin-outline"} is:inline class="text-[1.35rem] flex-shrink-0" />
				) : siteConfig.navbar.logo?.type === "image" && logoImg ? (
					logoImg.format === "svg" ? (
						<img src={logoImg.src} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-6 w-6 object-contain flex-shrink-0" fetchpriority="high" />
					) : (
						<Picture
							src={logoImg}
							alt={siteConfig.navbar.logo.alt || siteConfig.title}
							class="h-6 w-6 object-contain flex-shrink-0"
							formats={getImageFormats()}
							fallbackFormat={getFallbackFormat()}
							widths={[24, 48]}
							loading="eager"
							fetchpriority="high"
						/>
					)
				) : siteConfig.navbar.logo?.type === "image" ? (
					<img src={url(siteConfig.navbar.logo.value)} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-6 w-6 object-contain flex-shrink-0" fetchpriority="high" />
				) : siteConfig.navbar.logo?.type === "url" ? (
					<img src={siteConfig.navbar.logo.value} alt={siteConfig.navbar.logo.alt || siteConfig.title} class="h-6 w-6 object-contain flex-shrink-0" fetchpriority="high" />
				) : (
					<Icon name="material-symbols:home-pin-outline" is:inline class="text-[1.35rem] flex-shrink-0" />
				)}
				</a>
				<button
					type="button"
					class="navbar-logo-text font-mono uppercase tracking-[0.12em] text-xs font-semibold ml-2"
					data-nav-profile-trigger
					aria-expanded="false"
					aria-haspopup="dialog"
					title={navbarTitle}
				>
					{navbarTitle}
				</button>
			</div>

		<!-- 中段：紧凑导航椭圆（滚动不变） -->
		<div class="navbar-seg navbar-seg--center" data-navbar-nav>
			<div class="navbar-nav hidden lg:flex items-center gap-0.5 relative">
				<div class="navbar-hover-highlight" data-hover-border></div>

				{/* 浮动图标层：图标不画在按钮里，切页时由这一层「飞」到新项。
				    current / next 两层叠在同一个网格单元里做交叉淡换 */}
				<span class="navbar-moving-icon" data-navbar-moving-icon aria-hidden="true">
					<span class="navbar-moving-icon__glyph" data-navbar-icon-current></span>
					<span class="navbar-moving-icon__glyph" data-navbar-icon-next></span>
				</span>

				{links.map((link, index) => (
					<DropdownMenu link={link} index={index} />
				))}

				{dropdownPages.length > 0 && (
					<div class="navbar-dropdown-panel" data-navbar-dropdown-panel>
						<span class="navbar-dropdown-arrow" aria-hidden="true"></span>
						<div class="navbar-dropdown-box">
							{dropdownPages.map((page) => (
								<div class="navbar-dropdown-page" data-dropdown-page={page.index}>
									<span class="navbar-dropdown-highlight" aria-hidden="true"></span>
									{page.grid ? (
										<div class="dropdown-grid">
											{page.children.map((child) => (
												<a
													href={child.external ? child.url : url(child.url)}
													target={child.external ? "_blank" : undefined}
													class="dropdown-item"
													style={(child.depth ?? 1) > 1 ? `padding-left: calc(0.65rem + ${Math.min((child.depth ?? 1) - 1, 2) * 0.85}rem)` : undefined}
												>
													{child.icon && <Icon name={child.icon} class="text-[1.15rem] navbar-subitem-icon" />}
													<span class="dropdown-item-label">{child.name}</span>
													{child.external && (
														<Icon name="fa7-solid:arrow-up-right-from-square" class="text-[0.75rem] ml-auto text-black/25 dark:text-white/25" />
													)}
												</a>
											))}
										</div>
									) : (
										page.children.map((child, childIndex) => (
											<DropdownItem
												href={child.external ? child.url : url(child.url)}
												target={child.external ? "_blank" : undefined}
												isLast={childIndex === page.children.length - 1}
												class="dropdown-item"
											>
												{child.icon && <Icon name={child.icon} class="text-[1.25rem] mr-3 navbar-subitem-icon" />}
												<span
													class="dropdown-item-label"
													style={(child.depth ?? 1) > 1 ? `padding-left: ${Math.min((child.depth ?? 1) - 1, 2) * 0.85}rem` : undefined}
												>
													{child.name}
												</span>
												{typeof child.count === "number" && <span class="dropdown-item-count">{child.count}</span>}
												{child.external && (
													<Icon name="fa7-solid:arrow-up-right-from-square" class="text-[0.75rem] text-black/25 dark:text-white/25 ml-auto" />
												)}
											</DropdownItem>
										))
									)}
								</div>
							))}
						</div>
					</div>
				)}
			</div>
		</div>

		<!-- 右段：工具按钮（滚动收缩成球），移动端追加菜单按钮 -->
		<div class="navbar-seg navbar-seg--right">
			<button
				aria-label={i18n(I18nKey.tools)}
				aria-haspopup="menu"
				aria-expanded="false"
				name="Tools"
				class="btn-plain h-9 nav-tools-btn"
				id="nav-tools-btn"
				type="button"
			>
				<Icon name="material-symbols:instant-mix-outline-rounded" is:inline class="text-[1.35rem]" style="font-variation-settings: 'wght' 500" />
			</button>
			<button aria-label="Menu" name="Nav Menu" class="btn-plain h-9 w-9 lg:hidden!" id="nav-menu-switch">
				<Icon name="material-symbols:menu-rounded" is:inline class="text-[1.2rem]" />
			</button>
		</div>

		<!-- 工具面板：挂在 .navbar-segments 下（右段收缩态 overflow:hidden 会裁掉它），
		     水平位置由 navbar-tools-panel.ts 实测 -->
		<div class="nav-tools-panel" id="nav-tools-panel">
			<div class="nav-tools-box" role="menu" aria-label={i18n(I18nKey.tools)}>
				<span class="nav-tools-highlight" aria-hidden="true"></span>

				<button class="nav-tools-item" type="button" role="menuitem" data-nav-search-trigger data-nav-tools-stop>
					<Icon name="material-symbols:search-rounded" class="nav-tools-item__icon" />
					<span>{i18n(I18nKey.search)}</span>
					<kbd class="nav-tools-keys">
						<span data-nav-tools-modifier>Ctrl</span><span>K</span>
					</kbd>
				</button>

				{showAnnouncement && (
					<button class="nav-tools-item" type="button" role="menuitem" id="nav-tools-announcement" data-nav-tools-stop>
						<Icon name="material-symbols:campaign-outline-rounded" class="nav-tools-item__icon" />
						<span>{announcementConfig.title || i18n(I18nKey.announcement)}</span>
					</button>
				)}

				<div class="nav-tools-item nav-tools-item--group" data-nav-tools-stop="group">
					<Icon name="material-symbols:palette-outline" class="nav-tools-item__icon" />
					<span>{i18n(I18nKey.theme)}</span>
					<div class="nav-tools-segments" role="group" aria-label={i18n(I18nKey.theme)}>
						<span class="nav-tools-thumb" aria-hidden="true"></span>
						{toolsThemeOptions.map((option) => (
							<button
								class="nav-tools-segment"
								type="button"
								role="menuitemradio"
								aria-checked="false"
								aria-label={option.label}
								title={option.label}
								data-nav-tools-theme={option.value}
							>
								<Icon name={option.icon} class="nav-tools-segment__icon" />
							</button>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>

	{showAnnouncement && (
		<dialog id="nav-announcement-modal" class="privacy-modal" aria-label={announcementConfig.title || i18n(I18nKey.announcement)}>
			<div class="privacy-overlay" data-nav-announcement-close></div>
			<div class="privacy-panel">
				<div class="privacy-header">
					<h2 class="privacy-title nav-announcement-title">
						<Icon name="material-symbols:campaign-outline-rounded" class="nav-announcement-title-icon" />
						{announcementConfig.title || i18n(I18nKey.announcement)}
					</h2>
					<button class="privacy-close" type="button" aria-label={i18n(I18nKey.announcementClose)} data-nav-announcement-close>
						<Icon name="material-symbols:close-rounded" />
					</button>
				</div>
				<div class="privacy-body">
					<p class="nav-announcement-body">{announcementConfig.content}</p>
				</div>
				<div class="privacy-footer">
					{announcementConfig.link?.enable && (
						<a class="btn-regular nav-announcement-link" href={announcementConfig.link.external ? announcementConfig.link.url : url(announcementConfig.link.url)} target={announcementConfig.link.external ? "_blank" : undefined}>
							{announcementConfig.link.text || i18n(I18nKey.viewDetails)}
						</a>
					)}
					<button class="privacy-confirm-btn" type="button" data-nav-announcement-close>
						{i18n(I18nKey.gotIt)}
					</button>
				</div>
			</div>
		</dialog>
	)}
</div>

<script>
	import { initNavbarActiveMotion, refreshActiveItem } from "@/utils/navbar-active-motion";
	import { initNavbarDropdownDelegation } from "@/utils/navbar-dropdown-controller";
	import { initNavbarScrollLayout } from "@/utils/navbar-scroll-layout";
	import { initNavbarToolsPanel } from "@/utils/navbar-tools-panel";

	// 导航栏在 Swup 容器之外、跨导航常驻，这几个初始化只需跑一次
	// （各模块内部都有 initialized guard，重复调用安全）
	initNavbarDropdownDelegation();
	initNavbarActiveMotion();
	initNavbarScrollLayout();
	initNavbarToolsPanel();

	// 换页后重新判定激活项：animate=true 让浮动图标从上一项「飞」到新项
	window.addEventListener("swup:content:replaced", () => {
		refreshActiveItem(true);
	});
</script>

{
	import.meta.env.PROD && (
		<script is:inline data-swup-ignore-script define:vars={{ scriptUrl: url('/pagefind/pagefind.js') }}>
			async function loadPagefind() {
				try {
					const response = await fetch(scriptUrl, { method: 'HEAD' });
					if (!response.ok) {
						throw new Error(`Pagefind script not found: ${response.status}`);
					}
					const pagefind = await import(scriptUrl);
					await pagefind.options({ excerptLength: 20 });
					window.pagefind = pagefind;
					document.dispatchEvent(new CustomEvent('pagefindready'));
				} catch (error) {
					console.error('Failed to load Pagefind:', error);
					window.pagefind = {
						search: () => Promise.resolve({ results: [] }),
						options: () => Promise.resolve(),
					};
					document.dispatchEvent(new CustomEvent('pagefindloaderror'));
				}
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', loadPagefind);
			} else {
				loadPagefind();
			}
		</script>
	)
}
