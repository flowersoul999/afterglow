---
import { Icon } from "astro-icon/components";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	link: NavBarLink;
	/** 在导航栏中的序号，与共享下拉面板的内容页（data-dropdown-page）配对 */
	index: number;
	class?: string;
}

const { link, index, class: className } = Astro.props;

// 检查 link 是否存在
if (!link) {
	return null;
}

// 子菜单内容页由 Navbar.astro 集中渲染进**共享面板**，这里只输出触发器。
// 整条导航只有一只面板，悬停到哪一项就滑到哪一项下方（见 navbar-dropdown-controller.ts）
const hasChildren = !!link.children && link.children.length > 0;
---

<div
	class:list={["dropdown-container", className]}
	data-dropdown
	data-dropdown-index={index}
>
	{hasChildren ? (
		<button
			aria-label={link.name}
			aria-haspopup="true"
			aria-expanded="false"
			class="btn-plain rounded-lg h-9 font-bold px-3 active:scale-95 dropdown-trigger-link navbar-link-item"
			data-dropdown-trigger
		>
			<div class="flex items-center">
				{link.icon && (
					<span class="navbar-trigger-icon" data-navbar-icon-template aria-hidden="true">
						<Icon name={link.icon} />
					</span>
				)}
				<span class="navbar-link-text">{link.name}</span>
				<Icon
					name="material-symbols:keyboard-arrow-down-rounded"
					class="text-[1.25rem] transition-transform duration-200 dropdown-arrow ml-1"
				/>
			</div>
		</button>
	) : (
		<a
			aria-label={link.name}
			href={link.external ? link.url : url(link.url)}
			target={link.external ? "_blank" : null}
			class="btn-plain rounded-lg h-9 font-bold px-3 active:scale-95 navbar-link-item"
		>
			<div class="flex items-center">
				{link.icon && (
					<span class="navbar-trigger-icon" data-navbar-icon-template aria-hidden="true">
						<Icon name={link.icon} />
					</span>
				)}
				<span class="navbar-link-text">{link.name}</span>
				{link.external && (
					<Icon
						name="fa7-solid:arrow-up-right-from-square"
						class="text-[0.875rem] transition -translate-y-px ml-1 text-black/20 dark:text-white/20"
					/>
				)}
			</div>
		</a>
	)}
</div>

<!-- 样式见 src/styles/components/dropdown.css 与 src/styles/layout/navbar-dropdown.css -->
