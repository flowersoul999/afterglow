---
import Icon from "@/components/common/Icon.astro";
import { musicPlayerConfig } from "@/config/musicConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
// 组件专属样式：按 CLAUDE.md §4.3 由组件自己 import，不进 main.css
import "@/styles/features/music-player.css";

/**
 * 桌面端可拖拽音乐组件（Swup 容器外持久存在）。
 * 三态：disc 收起唱片 → pill 播放中胶囊（唱片 + 歌词） → bar 展开 dock；
 * dock 上方只有一张展开卡：信息层（曲名 / 艺术家 / 进度）常驻，点歌单按钮时
 * 同一张卡向上长出歌单 / 歌词面板，信息层随之上移，不再是两张分离的卡片。
 *
 * 引擎复用本项目的 MusicManager 单例（window.__fireflyMusic，fm:* 事件广播），
 * 视图逻辑见 src/utils/music-player-controller.ts，
 * 样式见 src/styles/features/music-player.css。
 *
 * 根节点用 data-mp-widget 定位、不带 music-player-widget 类：
 * 旧的 MusicPlayer.astro（音乐页小组件）占着那个类名，避免控制器抓错元素。
 * 移动端（≤768px）隐藏，播放器只在桌面左下角出现。
 */
---

<div
	class="music-player"
	data-mp-widget
	data-state="disc"
	data-panel="closed"
	data-playing="false"
	role="region"
	aria-label={i18n(I18nKey.music)}
	hidden={musicPlayerConfig.showInNavbar === false}
>
	<div class="music-player__stage">
		<!-- 展开卡：面板与信息层共用一张表面 -->
		<div class="music-player__card">
			<div class="music-player__panel">
				<div class="music-player__panel-clip">
					<div class="music-player__panel-body">
						<div class="music-player__panel-tabs">
							<span class="music-player__tab-indicator" aria-hidden="true"></span>
							<button class="music-player__tab music-player__tab--playlist is-active" type="button">{i18n(I18nKey.musicPlaylist)}</button>
							<button class="music-player__tab music-player__tab--lyrics" type="button">{i18n(I18nKey.musicLyrics)}</button>
						</div>
						<div class="music-player__panel-views">
							<div class="music-player__playlist-view is-active">
								<div class="music-player__playlist-list custom-scrollbar" role="listbox" aria-label={i18n(I18nKey.musicPlaylist)}></div>
							</div>
							<div class="music-player__lyrics-view">
								<div class="music-player__lyrics-list custom-scrollbar" role="listbox" aria-label={i18n(I18nKey.musicLyrics)}>
									<div class="music-player__lyrics-placeholder">{i18n(I18nKey.musicNoLyrics)}</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- 信息层：bar 态常驻在展开卡底部，唱片骑在其左下角 -->
			<div class="music-player__info">
				<div class="music-player__info-clip">
					<div class="music-player__info-surface">
						<p class="music-player__title">{i18n(I18nKey.musicNoPlaying)}</p>
						<p class="music-player__artist"></p>
						<div class="music-player__progress-row">
							<span class="music-player__time-current">0:00</span>
							<div
								class="music-player__progress"
								role="slider"
								aria-label={i18n(I18nKey.musicProgress)}
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="0"
							>
								<div class="music-player__progress-bar"></div>
								<div class="music-player__progress-thumb"></div>
							</div>
							<span class="music-player__time-total">0:00</span>
						</div>
						<!-- 加载指示只占信息层，不再给整个组件蒙一层遮罩 -->
						<div class="music-player__loading" aria-hidden="true">
							<Icon name="material-symbols:sync-rounded" class="text-2xl" aria-hidden="true" />
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- 工具栏层：胶囊歌词槽与工具栏共用同一槽位交叉淡入 -->
		<div class="music-player__bar">
			<div class="music-player__slot">
				<span class="music-player__pill-text"><span class="music-player__pill-label"></span></span>
				<div class="music-player__toolbar">
					<button class="music-player__btn music-player__btn--mode" data-tooltip={i18n(I18nKey.playModeList)} aria-label={i18n(I18nKey.playModeList)} type="button">
						<Icon name="material-symbols:repeat-rounded" class="music-player__icon-mode-list text-xl" aria-hidden="true" />
						<Icon name="material-symbols:repeat-one-rounded" class="music-player__icon-mode-one text-xl hidden" aria-hidden="true" />
						<Icon name="material-symbols:shuffle-rounded" class="music-player__icon-mode-shuffle text-xl hidden" aria-hidden="true" />
					</button>
					<button class="music-player__btn music-player__btn--lyrics" data-tooltip={i18n(I18nKey.musicLyrics)} aria-label={i18n(I18nKey.musicLyrics)} aria-pressed="true" type="button">
						<Icon name="material-symbols:subtitles-outline-rounded" class="music-player__icon-lrc-on text-xl" aria-hidden="true" />
						<Icon name="material-symbols:subtitles-off-outline-rounded" class="music-player__icon-lrc-off text-xl hidden" aria-hidden="true" />
					</button>
					<button class="music-player__btn music-player__btn--prev" data-tooltip={i18n(I18nKey.musicPrev)} aria-label={i18n(I18nKey.musicPrev)} type="button">
						<Icon name="material-symbols:skip-previous-rounded" class="text-2xl" aria-hidden="true" />
					</button>
					<button class="music-player__btn music-player__btn--play" data-tooltip={i18n(I18nKey.musicPlay)} aria-label={i18n(I18nKey.musicPlay)} type="button">
						<Icon name="material-symbols:play-arrow-rounded" class="music-player__icon-play text-3xl" aria-hidden="true" />
						<Icon name="material-symbols:pause-rounded" class="music-player__icon-pause text-3xl hidden" aria-hidden="true" />
					</button>
					<button class="music-player__btn music-player__btn--next" data-tooltip={i18n(I18nKey.musicNext)} aria-label={i18n(I18nKey.musicNext)} type="button">
						<Icon name="material-symbols:skip-next-rounded" class="text-2xl" aria-hidden="true" />
					</button>
					<button class="music-player__btn music-player__btn--playlist" data-tooltip={i18n(I18nKey.musicPlaylist)} aria-label={i18n(I18nKey.musicPlaylist)} type="button">
						<Icon name="mdi:playlist-music" class="text-xl" aria-hidden="true" />
					</button>
					<div class="music-player__volume">
						<button class="music-player__btn music-player__btn--volume" data-tooltip={i18n(I18nKey.musicVolume)} aria-label={i18n(I18nKey.musicVolume)} type="button">
							<Icon name="material-symbols:volume-up-rounded" class="music-player__icon-vol-on text-xl" aria-hidden="true" />
							<Icon name="material-symbols:volume-off-rounded" class="music-player__icon-vol-off text-xl hidden" aria-hidden="true" />
						</button>
						<div class="music-player__volume-pop">
							<Icon name="material-symbols:volume-down-rounded" class="music-player__volume-icon music-player__volume-icon--start text-lg" aria-hidden="true" />
							<div
								class="music-player__volume-track"
								role="slider"
								aria-label={i18n(I18nKey.musicVolume)}
								aria-orientation="horizontal"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow="70"
							>
								<div class="music-player__volume-bar"></div>
								<div class="music-player__volume-thumb"></div>
								<span class="music-player__volume-bubble" aria-hidden="true">70%</span>
							</div>
							<Icon name="material-symbols:volume-up-rounded" class="music-player__volume-icon music-player__volume-icon--end text-lg" aria-hidden="true" />
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- 唱片：三态复用的圆碟，位置随形态过渡 -->
		<button class="music-player__disc" type="button" aria-label={i18n(I18nKey.music)}>
			<Icon name="material-symbols:music-note-rounded" class="music-player__disc-placeholder text-2xl" aria-hidden="true" />
			<img class="music-player__disc-img is-empty" src="" alt="" draggable="false" />
		</button>
	</div>

	<!-- 尺寸探针：控制器据此读取 --mp-width / --mp-bar-h / --mp-disc-rise 的实际像素值，
	     用于按当前形态夹取拖拽位置（根元素宽高在过渡中，量不到目标值） -->
	<span class="music-player__probe" aria-hidden="true">
		<span class="music-player__probe-bar"></span>
		<span class="music-player__probe-rise"></span>
	</span>
</div>

<template id="music-player-item-template">
	<div class="music-player__track" role="option">
		<div class="music-player__track-cover-wrap">
			<img src="" class="music-player__track-cover" loading="lazy" alt="" />
			<div class="music-player__track-active hidden">
				<Icon name="material-symbols:graphic-eq-rounded" class="text-sm" aria-hidden="true" />
			</div>
		</div>
		<div class="music-player__track-meta">
			<div class="music-player__track-title"></div>
			<div class="music-player__track-artist"></div>
		</div>
	</div>
</template>

<script>
	import { setupMusicPlayerWidget } from "@/utils/music-player-controller";

	// 组件挂在 Layout 的 <slot /> 之后（Swup 容器外），DOM 跨导航持久存在，
	// 因此整个文档生命周期只初始化一次；这里用 window 单例守卫防重复绑定。
	// 引擎 window.__fireflyMusic 由 MusicManager 的内联脚本同步赋值，
	// 而本脚本是 defer 的普通模块脚本，执行时引擎必然已就位。
	if (!window.__musicPlayerWidgetReady) {
		window.__musicPlayerWidgetReady = true;
		setupMusicPlayerWidget();
	}
</script>
