<div
	id="page-loader"
	class="page-loader page-loader--hidden"
	hidden
	role="status"
	aria-live="polite"
	aria-label="Page loading"
>
	<div
		aria-label="Running animation"
		role="img"
		class="page-loader__animation"
	>
		<img
			src="/assets/images/loading/1000023867.webp"
			alt=""
			class="page-loader__image"
			width="362"
			height="74"
			decoding="async"
		/>
	</div>
	<span class="page-loader__sr-only">Loading</span>
</div>
