---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import PageTitle from "@/components/common/PageTitle.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 获取所有导航数据
const allEntries = await getCollection("daohang");

// 分类由「文件所在的文件夹」决定（不再写 frontmatter.category）
// 迁移前的老数据都在 daohang 根目录，没有目录时归入「未分类」

/**
 * 分类元数据：显示名 / 排序 / 图标 / 标语。
 * key 用文件夹名，比较时统一按「小写 + 空格转连字符」归一化：
 * Astro 生成 entry id 时会把大写转小写、空格转连字符（`AI 工具` → `ai-工具`），
 * 所以映射表不能只按原样匹配。
 *
 * `tagline` 是标题行右侧那句标语（参考站同款位置），留空就不显示。
 * ⚠️ 左栏是竖排列表，order 决定它在左栏与内容区的先后 —— 新增分类务必在这里登记，
 * 漏登记的会带着默认图标掉到列表末尾（踩过：AI / 开发者工具 / 开发者服务平台）。
 */
const CATEGORY_META: Record<
	string,
	{ display: string; order: number; icon: string; tagline?: string }
> = {
	我的网站: {
		display: "我的网站",
		order: 0,
		icon: "material-symbols:person",
		tagline: "自己折腾出来的，都放这儿",
	},
	常用网站: {
		display: "常用网站",
		order: 1,
		icon: "material-symbols:star",
		tagline: "每天都要点开的那几个",
	},
	在用网站: {
		display: "在用网站",
		order: 1.5,
		icon: "material-symbols:star",
		tagline: "手上正在用的，就这几家",
	},
	工具网站: {
		display: "工具网站",
		order: 2,
		icon: "material-symbols:handyman",
		tagline: "开箱即用，省事省心",
	},
	开发者工具: {
		display: "开发者工具",
		order: 3,
		icon: "material-symbols:terminal",
		tagline: "写代码离不开这一套",
	},
	开发者服务平台: {
		display: "开发者服务平台",
		order: 4,
		icon: "material-symbols:cloud",
		tagline: "部署、托管、跑起来",
	},
	AI: {
		display: "AI",
		order: 5,
		icon: "material-symbols:smart-toy",
		tagline: "各路大模型，挨个问一遍",
	},
	"AI 工具": {
		display: "AI 工具",
		order: 5,
		icon: "material-symbols:smart-toy",
		tagline: "从对话到画图，一网打尽",
	},
	学习网站: {
		display: "学习网站",
		order: 6,
		icon: "material-symbols:school",
		tagline: "刷题练手，慢慢变强",
	},
	文档: {
		display: "文档",
		order: 7,
		icon: "material-symbols:description",
		tagline: "查手册的第一站",
	},
	设计资源: {
		display: "设计资源",
		order: 8,
		icon: "material-symbols:palette",
		tagline: "配色图标字体，随手就取",
	},
	实用项目: {
		display: "实用项目",
		order: 9,
		icon: "material-symbols:deployed-code",
		tagline: "自己动手，够用就好",
	},
	API: {
		display: "API",
		order: 10,
		icon: "material-symbols:api",
		tagline: "接口都在这儿，接上就能跑",
	},
	资源网站: {
		display: "资源网站",
		order: 11,
		icon: "material-symbols:folder",
		tagline: "找资源先来这儿翻翻",
	},
	影视网站: {
		display: "影视网站",
		order: 12,
		icon: "material-symbols:movie",
		tagline: "追剧看片，这儿管够",
	},
	其他网站: {
		display: "其他网站",
		order: 12.5,
		icon: "material-symbols:link",
		tagline: "杂七杂八，先收着",
	},
	未分类: {
		display: "未分类",
		order: 13,
		icon: "material-symbols:link",
		tagline: "还没归好类，先放着",
	},
};

/** 归一化：小写 + 空格转连字符，与 Astro 的 entry id 规则对齐 */
const normalizeCatKey = (name: string) =>
	name.toLowerCase().replace(/\s+/g, "-");

/** 从 entry id 取分类：id 形如「我的网站/xxx.md」或「xxx.md」 */
function getFolderCategory(id: string): string {
	const normalized = id.replace(/\\/g, "/").replace(/\.(md|mdx)$/i, "");
	const slash = normalized.lastIndexOf("/");
	return slash < 0 ? "未分类" : normalized.slice(0, slash);
}

function getCategoryMeta(folder: string) {
	const key = normalizeCatKey(folder);
	for (const [k, v] of Object.entries(CATEGORY_META)) {
		if (normalizeCatKey(k) === key) return v;
	}
	return {
		display: folder,
		order: 99,
		icon: "material-symbols:link",
		tagline: "",
	};
}

// 按分类分组
const categoryMap = new Map<
	string,
	{ items: typeof allEntries; display: string; order: number; icon: string }
>();

allEntries.forEach((entry) => {
	const folder = getFolderCategory(entry.id);
	const meta = getCategoryMeta(folder);
	if (!categoryMap.has(folder)) {
		categoryMap.set(folder, {
			items: [],
			display: meta.display,
			order: meta.order,
			icon: meta.icon,
		});
	}
	categoryMap.get(folder)?.items.push(entry);
});

// 分类排序
const sortedCategories = [...categoryMap.entries()]
	.sort(([, a], [, b]) => a.order - b.order)
	.map(([folder]) => folder);

const sortedData = new Map(
	[...categoryMap.entries()]
		.sort(([, a], [, b]) => a.order - b.order)
		.map(([folder, { items }]) => [
			folder,
			// 导航条目已不再写 order 字段，分类内按名称排序（中文按拼音）
			[...items].sort((a, b) =>
				a.data.name.localeCompare(b.data.name, "zh-CN"),
			),
		]),
);

const getCategoryIcon = (cat: string) => getCategoryMeta(cat).icon;
const getCategoryDisplay = (cat: string) => getCategoryMeta(cat).display;

// 计算每个分类的数量
const categoryCounts: Record<string, number> = {};
for (const [cat, items] of sortedData) {
	categoryCounts[cat] = items.length;
}

// 所有启用的网站（扁平列表）
const allSites = sortedCategories.flatMap((cat) => sortedData.get(cat) ?? []);

/**
 * 每个分类里出现过的标签 —— 标题行那一排子标签就用它（个数多的靠前，其次按名称）。
 * 标签来自条目 frontmatter 的 `tags`（后台「标签」字段）；一个都没填时这一排不渲染。
 */
const categoryTags = new Map<string, string[]>();
for (const [cat, items] of sortedData) {
	const counts = new Map<string, number>();
	for (const item of items) {
		for (const tag of item.data.tags ?? []) {
			counts.set(tag, (counts.get(tag) ?? 0) + 1);
		}
	}
	categoryTags.set(
		cat,
		[...counts.entries()]
			.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "zh-CN"))
			.map(([tag]) => tag),
	);
}

const getCategoryTagline = (cat: string) => getCategoryMeta(cat).tagline ?? "";

/** 卡片上的域名；解析失败就退回原串 */
const hostOf = (url: string): string => {
	try {
		return new URL(url).hostname;
	} catch {
		return url;
	}
};
---

<MainGridLayout title="网站导航" description="收录个人网站、常用工具和收藏网站">

  <!-- 左栏分类 + 搜索（纯前端筛选：52 条链接本来就渲染在页面里，不发请求） -->
  <script slot="head" is:inline>
    (function () {
      /* 一次性绑定 document 级监听（head 脚本在 Swup 换页时可能被重新插入，重复绑定会跑两遍） */
      if (window.__navPageBound) return;
      window.__navPageBound = true;

      var ANCHOR = "#nav-";
      var searchTimer = null;

      function els() {
        return {
          side: document.querySelector("[data-nav-side]"),
          sections: Array.prototype.slice.call(document.querySelectorAll("[data-nav-section]")),
          cards: Array.prototype.slice.call(document.querySelectorAll(".nav-card")),
          input: document.getElementById("nav-search"),
          clear: document.getElementById("nav-search-clear"),
          count: document.getElementById("nav-search-count"),
          empty: document.getElementById("nav-search-empty"),
        };
      }

      function currentCat() {
        var btn = document.querySelector("[data-nav-cat].is-active");
        return btn ? btn.getAttribute("data-nav-cat") : "all";
      }

      /* ---------- 分类切换 ---------- */
      function setActive(cat, writeHash) {
        var e = els();
        if (!e.sections.length) return;

        Array.prototype.forEach.call(document.querySelectorAll("[data-nav-cat]"), function (btn) {
          btn.classList.toggle("is-active", btn.getAttribute("data-nav-cat") === cat);
        });
        e.sections.forEach(function (sec) {
          sec.classList.toggle("hidden", cat !== "all" && sec.getAttribute("data-nav-section") !== cat);
        });

        if (writeHash === false) return;
        var next = ANCHOR + encodeURIComponent(cat);
        if (window.location.hash !== next) {
          window.history.replaceState(null, "", next);
        }
      }

      /* ---------- 筛选：搜索（名称 / 描述 / 域名）+ 每个分区自己的标签 ---------- */
      function activeTagOf(section) {
        var btn = section.querySelector(".nav-tab.is-active");
        return btn ? btn.getAttribute("data-nav-tag") || "" : "";
      }

      function applyFilters() {
        var e = els();
        if (!e.input || !e.cards.length) return;

        var q = (e.input.value || "").trim().toLowerCase();
        if (e.clear) e.clear.hidden = !q;
        /* 一开始输入就切到「全部」：搜的是整站收藏，而不是当前分类里的 */
        if (q && currentCat() !== "all") setActive("all");

        var totalHits = 0;
        e.sections.forEach(function (sec) {
          var tag = activeTagOf(sec);
          var hits = 0;
          Array.prototype.forEach.call(sec.querySelectorAll(".nav-card"), function (card) {
            var okSearch =
              !q ||
              [
                card.getAttribute("data-name") || "",
                card.getAttribute("data-desc") || "",
                card.getAttribute("data-host") || "",
              ]
                .join(" ")
                .toLowerCase()
                .indexOf(q) >= 0;
            var okTag =
              !tag ||
              (card.getAttribute("data-tags") || "").split(",").indexOf(tag) >= 0;
            var ok = okSearch && okTag;
            card.classList.toggle("hidden", !ok);
            if (ok) hits++;
          });
          /* 整段一个都不剩就隐藏该段（含标题行） */
          sec.classList.toggle("hidden", hits === 0);
          totalHits += hits;
        });

        if (e.count) e.count.textContent = q ? "找到 " + totalHits + " 个" : "";
        if (e.empty) e.empty.hidden = !q || totalHits > 0;
      }

      function clearSearch() {
        var e = els();
        if (!e.input) return;
        e.input.value = "";
        applyFilters();
        e.input.focus();
      }

      function bindSearch() {
        var e = els();
        if (e.input && !e.input.dataset.navBound) {
          e.input.dataset.navBound = "1";
          e.input.addEventListener("input", function () {
            if (searchTimer) clearTimeout(searchTimer);
            searchTimer = setTimeout(applyFilters, 150);
          });
          e.input.addEventListener("keydown", function (ev) {
            if (ev.key === "Escape") clearSearch();
          });
        }
        if (e.clear && !e.clear.dataset.navBound) {
          e.clear.dataset.navBound = "1";
          e.clear.addEventListener("click", clearSearch);
        }
        var emptyClear = document.getElementById("nav-search-empty-clear");
        if (emptyClear && !emptyClear.dataset.navBound) {
          emptyClear.dataset.navBound = "1";
          emptyClear.addEventListener("click", clearSearch);
        }
      }

      /* 标题行那排子标签：点谁按谁筛该分区的卡片（默认「全部」） */
      function bindTabs() {
        Array.prototype.forEach.call(
          document.querySelectorAll("[data-nav-tabs]"),
          function (group) {
            if (group.dataset.navBound) return;
            group.dataset.navBound = "1";
            group.addEventListener("click", function (ev) {
              var btn = ev.target.closest("[data-nav-tag]");
              if (!btn) return;
              Array.prototype.forEach.call(
                group.querySelectorAll(".nav-tab"),
                function (b) {
                  b.classList.toggle("is-active", b === btn);
                },
              );
              applyFilters();
            });
          },
        );
      }

      /* ---------- 悬浮/聚焦卡片：浮层里显示完整描述 + 域名 ----------
         卡片上的描述只占一行（超出省略），完整内容靠这个共用浮层展示。
         用 JS 定位（而不是 CSS 伪元素）：卡片在网格里的位置不定，浮层要能自动
         贴住左右边界、下面放不下时翻到上方，箭头再指向卡片中心。 */
      function bindTip() {
        var tip = document.getElementById("nav-tip");
        if (!tip || tip.dataset.navBound) return;
        tip.dataset.navBound = "1";

        var descEl = document.getElementById("nav-tip-desc");
        var urlEl = document.getElementById("nav-tip-url");
        var showTimer = null;
        var GAP = 10;

        function place(card) {
          var r = card.getBoundingClientRect();
          tip.classList.add("is-visible");
          var tw = tip.offsetWidth;
          var th = tip.offsetHeight;
          var left = r.left + r.width / 2 - tw / 2;
          var maxLeft = window.innerWidth - tw - 12;
          if (left > maxLeft) left = maxLeft;
          if (left < 12) left = 12;
          var top = r.bottom + GAP;
          var above = top + th > window.innerHeight - 12;
          if (above) top = Math.max(12, r.top - th - GAP);
          tip.classList.toggle("is-above", above);
          tip.style.left = Math.round(left) + "px";
          tip.style.top = Math.round(top) + "px";
          var arrowX = Math.round(r.left + r.width / 2 - left);
          tip.style.setProperty(
            "--nav-tip-arrow-x",
            Math.min(Math.max(arrowX, 16), tw - 16) + "px",
          );
        }

        function show(card) {
          if (showTimer) clearTimeout(showTimer);
          showTimer = setTimeout(function () {
            var desc = card.getAttribute("data-desc") || "";
            var host = card.getAttribute("data-host") || "";
            if (descEl) {
              descEl.textContent = desc;
              descEl.hidden = !desc;
            }
            if (urlEl) {
              urlEl.textContent = host;
              urlEl.hidden = !host;
            }
            /* 描述与域名都空就不弹了 */
            if (!desc && !host) return;
            place(card);
          }, 100);
        }

        function hide() {
          if (showTimer) {
            clearTimeout(showTimer);
            showTimer = null;
          }
          tip.classList.remove("is-visible");
        }

        function cardOf(target) {
          return target && target.closest ? target.closest(".nav-card") : null;
        }

        document.addEventListener("pointerover", function (ev) {
          var card = cardOf(ev.target);
          if (card) show(card);
        });
        document.addEventListener("pointerout", function (ev) {
          if (cardOf(ev.target)) hide();
        });
        document.addEventListener("focusin", function (ev) {
          var card = cardOf(ev.target);
          if (card) show(card);
        });
        document.addEventListener("focusout", hide);
        window.addEventListener("scroll", hide, { passive: true });
        window.addEventListener("resize", hide, { passive: true });
      }

      /* ---------- 初始化（Swup 换页后重新取元素） ---------- */
      function init() {
        var side = document.querySelector("[data-nav-side]");
        if (!side || !document.querySelector("[data-nav-section]")) return;

        if (!side.dataset.navBound) {
          side.dataset.navBound = "1";
          side.addEventListener("click", function (ev) {
            var btn = ev.target.closest("[data-nav-cat]");
            if (!btn) return;
            setActive(btn.getAttribute("data-nav-cat"));
          });
        }

        bindSearch();
        bindTabs();
        bindTip();

        var fromHash = "";
        try {
          fromHash = decodeURIComponent(window.location.hash.replace(ANCHOR, ""));
        } catch (err) {
          fromHash = "";
        }
        var known = Array.prototype.some.call(
          document.querySelectorAll("[data-nav-cat]"),
          function (btn) { return btn.getAttribute("data-nav-cat") === fromHash; },
        );
        setActive(known ? fromHash : "all", false);
      }

      function reinit() {
        init();
        applyFilters();
      }

      document.addEventListener("click", function (ev) {
        var emptyClear = ev.target.closest("#nav-search-empty-clear");
        if (emptyClear) clearSearch();
      });

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
      document.addEventListener("astro:page-load", reinit);
      document.addEventListener("astro:after-swap", reinit);
      document.addEventListener("swup:content:replaced", reinit);
      window.addEventListener("hashchange", init);
    })();
  </script>

  <div class="flex w-full rounded-(--radius-large) overflow-clip relative min-h-32">
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
      <!-- 页面标题（PageTitle：英文小字 + SVG 签写入场动画 + 描述） -->
      <div class="mb-8">
        <PageTitle
          title="网站导航"
          eyebrow="Collections"
          description="收录个人网站、常用工具和收藏网站"
        />
      </div>

      {allSites.length > 0 ? (
        <div class="nav-layout">
          <!-- 左栏：全部分类（窄屏收成顶部横向可滑的胶囊） -->
          <aside class="nav-side" data-nav-side aria-label="分类导航">
            <button type="button" class="nav-side__item is-active" data-nav-cat="all">
              <Icon name="material-symbols:apps" is:inline class="nav-side__icon" />
              <span class="nav-side__label">全部</span>
              <span class="nav-side__count">{allSites.length}</span>
            </button>
            {sortedCategories.map((cat) => (
              <button type="button" class="nav-side__item" data-nav-cat={cat}>
                <Icon name={getCategoryIcon(cat)} is:inline class="nav-side__icon" />
                <span class="nav-side__label">{getCategoryDisplay(cat)}</span>
                <span class="nav-side__count">{categoryCounts[cat]}</span>
              </button>
            ))}
          </aside>

          <!-- 内容区：搜索 + 各分类分区 -->
          <div class="nav-main">
            <div class="nav-search">
              <span class="nav-search__icon">
                <Icon name="material-symbols:search-rounded" is:inline />
              </span>
              <input
                id="nav-search"
                type="search"
                class="nav-search__input"
                placeholder="搜索网站…"
                aria-label="搜索网站"
                autocomplete="off"
              />
              <button
                id="nav-search-clear"
                type="button"
                class="nav-search__clear"
                aria-label="清空搜索"
                hidden
              >
                <Icon name="material-symbols:close-rounded" is:inline />
              </button>
              <span class="nav-search__count" id="nav-search-count"></span>
            </div>

            <p class="nav-search__empty" id="nav-search-empty" hidden>
              没找到匹配的网站
              <button type="button" id="nav-search-empty-clear">清空搜索</button>
            </p>

            {sortedCategories.map((cat) => {
              const catSites = sortedData.get(cat)!;
              if (catSites.length === 0) return null;
              const tags = categoryTags.get(cat) ?? [];
              const tagline = getCategoryTagline(cat);
              return (
                <section class="nav-section" data-nav-section={cat}>
                  <div class="nav-section__head">
                    <Icon name={getCategoryIcon(cat)} is:inline class="nav-section__icon" />
                    <h2 class="nav-section__title">{getCategoryDisplay(cat)}</h2>
                    <span class="nav-section__count">{catSites.length}</span>
                    {tags.length > 0 && (
                      <>
                        <span class="nav-section__sep" aria-hidden="true" />
                        <div class="nav-section__tabs" data-nav-tabs={cat} role="group" aria-label={`${getCategoryDisplay(cat)}标签`}>
                          <button type="button" class="nav-tab is-active" data-nav-tag="">
                            全部
                          </button>
                          {tags.map((tag) => (
                            <button type="button" class="nav-tab" data-nav-tag={tag}>
                              {tag}
                            </button>
                          ))}
                        </div>
                      </>
                    )}
                    {tagline && <span class="nav-section__tagline">{tagline}</span>}
                  </div>
                  <div class="nav-grid">
                    {catSites.map((site, index) => (
                      <a
                        href={site.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="nav-card"
                        data-name={site.data.name}
                        data-desc={site.data.description || ""}
                        data-host={hostOf(site.data.url)}
                        data-tags={(site.data.tags ?? []).join(",")}
                        style={`--nav-card-i: ${Math.min(index, 8)}`}
                      >
                        <span class="nav-card__icon">
                          {site.data.icon && /^(https?:|\/)/.test(site.data.icon) ? (
                            <img src={site.data.icon} alt="" loading="lazy" />
                          ) : (
                            <Icon
                              name={site.data.icon || "material-symbols:language"}
                              is:inline
                            />
                          )}
                        </span>
                        <span class="nav-card__body">
                          <span class="nav-card__title">{site.data.name}</span>
                          <span class="nav-card__desc">{site.data.description}</span>
                        </span>
                      </a>
                    ))}
                  </div>
                </section>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="text-center py-16">
          <Icon name="material-symbols:bookmark-outline" is:inline class="text-5xl text-neutral-300 dark:text-neutral-600 mb-4" />
          <p class="text-neutral-500 dark:text-neutral-400">暂无收录的网站</p>
        </div>
      )}
    </div>
  </div>

