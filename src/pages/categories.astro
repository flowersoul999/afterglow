---
import KnowledgeGraph from "@components/widget/KnowledgeGraph.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";
import { getKnowledgeGraphData } from "@/utils/content-utils";
import { getCategoryUrl, url } from "@/utils/url-utils";

// 页面开关：关闭时重定向到 404（与 archive / music 等页面保持一致）
if (!siteConfig.pages.categories) {
	return Astro.redirect("/404/");
}

// 只取 meta（几百字节）内联；节点与边走 /api/knowledge-graph.json
const { meta } = await getKnowledgeGraphData();

const title = i18n(I18nKey.tagGraphPageTitle);
const description = i18n(I18nKey.tagGraphPageDescription);
---

<MainGridLayout title={title} description={description}>
  <Fragment slot="head">
    {/* 解析 HTML 时就并发拉图数据，抵消独立端点多出的那次往返 */}
    <link rel="prefetch" href={url("/api/knowledge-graph.json")} as="fetch" crossorigin="anonymous" />
  </Fragment>

  {/* SEO / 读屏 / 无 JS 兜底：全站分类的精简内链清单。
      画布与详情面板都是纯 JS，不执行 JS 的爬虫（百度/头条）只能靠这一节
      拿到枢纽页内链；文章本体由 sitemap / 归档页 / 列表页覆盖，这里不重复。
      视觉隐藏用 sr-only（clip 而非 display:none），链接仍可被提取。
      顶部 H1 由 MainGridLayout 统一输出，这里不再重复一个。 */}
  <nav class="sr-only" aria-label={title}>
    <h2>{i18n(I18nKey.categories)}</h2>
    <ul>
      {meta.categories.map((category) => (
        <li>
          <a href={getCategoryUrl(category.name)}>{category.name}</a>（{category.postCount}）
        </li>
      ))}
    </ul>
    <p>{description}</p>
  </nav>

  <div class="graph-page">
    <KnowledgeGraph meta={meta} />
  </div>
</MainGridLayout>
