---
import { getCollection } from "astro:content";
import path from "node:path";
import PageTitle from "@/components/common/PageTitle.astro";
import AlbumGallery from "@/components/pages/album/AlbumGallery.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	type AlbumGalleryPhoto,
	mergePhotoTags,
	normalizeAlbumPhoto,
} from "@/utils/album-gallery";
import { formatDateI18n } from "@/utils/date-utils";
import { scanLocalAlbumPhotos } from "@/utils/local-album";

const albums = (await getCollection("album"))
	.filter(
		(album) => import.meta.env.PROD === false || album.data.draft !== true,
	)
	.sort(
		(left, right) =>
			new Date(right.data.date).getTime() - new Date(left.data.date).getTime(),
	);

const imgbedUrl = import.meta.env.PUBLIC_IMAGEBED_URL || "";
const imgbedToken = import.meta.env.PUBLIC_IMAGEBED_API_TOKEN || "";
const localAlbumRoot = path.join(
	process.cwd(),
	"public",
	"assets",
	"images",
	"albums",
);

function withAlbumMetadata(
	photo: AlbumGalleryPhoto,
	albumTags: string[],
	albumDate: Date,
) {
	const takenAtDate = photo.takenAt ? new Date(photo.takenAt) : albumDate;
	const validTakenAt = !Number.isNaN(takenAtDate.getTime());
	return {
		...photo,
		tags: mergePhotoTags(albumTags, photo.tags),
		takenAtText: validTakenAt
			? formatDateI18n(takenAtDate, Boolean(photo.takenAt))
			: photo.takenAt,
	};
}

const albumMeta = await Promise.all(
	albums.map(async (album) => {
		const albumDate = new Date(album.data.date);
		const declaredPhotos = (album.data.photos || [])
			.map(normalizeAlbumPhoto)
			.filter((photo): photo is AlbumGalleryPhoto => photo !== null)
			.map((photo) =>
				withAlbumMetadata(photo, album.data.tags || [], albumDate),
			);
		const localPhotos = (
			await scanLocalAlbumPhotos({
				rootDir: localAlbumRoot,
				folder: album.data.localFolder || "",
			})
		)
			.map(normalizeAlbumPhoto)
			.filter((photo): photo is AlbumGalleryPhoto => photo !== null)
			.map((photo) =>
				withAlbumMetadata(photo, album.data.tags || [], albumDate),
			);

		// 显式照片优先，确保 caption、tags、takenAt 等单张元数据不会被目录扫描结果覆盖。
		const photos = [...declaredPhotos, ...localPhotos].filter(
			(photo, index, values) =>
				values.findIndex((candidate) => candidate.src === photo.src) === index,
		);

		return {
			id: album.id,
			title: album.data.title,
			subtitle: album.data.subtitle || "",
			date: albumDate.toISOString(),
			dateText: formatDateI18n(albumDate),
			location: album.data.location || "",
			tags: album.data.tags || [],
			photos,
			folder: album.data.imgbedFolder || "",
		};
	}),
);
---

<MainGridLayout
	title="相册"
	description="可以亲手摆放的照片桌，也可以切换成整齐的照片墙"
>
	<div class="relative flex min-h-32 w-full overflow-clip rounded-(--radius-large)">
		<div class="card-base relative z-10 w-full px-4 py-6 md:px-9">
			<div class="mb-5">
				<PageTitle
					title="相册"
					eyebrow="Album"
					description="拖动照片，重新摆放那些被时间留下来的瞬间"
				/>
			</div>

			<AlbumGallery
				albums={albumMeta}
				imgbedUrl={imgbedUrl}
				imgbedToken={imgbedToken}
			/>
		</div>
	</div>
</MainGridLayout>
